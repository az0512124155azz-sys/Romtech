# Server-only. Never prefix these with NEXT_PUBLIC_, VITE_, or expose in HTML.
ROMTECH_ORIGIN=https://romtech-alpha.vercel.app
ROMTECH_STORE_PREFIX=romtech-production
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel's Upstash integration may provide KV_REST_API_URL and
# KV_REST_API_TOKEN instead; RomTech detects those names automatically.
# 32 random bytes, base64 encoded. Keep stable across deployments.
ROMTECH_ENCRYPTION_KEY=
# Generated by npm run owner-password (reads the password without echo).
ROMTECH_OWNER_PASSWORD_HASH=
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
# Vercel Integration credentials. Configure Project scope as Read/Write.
# Keep the secret server-only; customers never paste or see an access token.
VERCEL_INTEGRATION_SLUG=romtech
VERCEL_OAUTH_CLIENT_ID=
VERCEL_OAUTH_CLIENT_SECRET=
# Set only when VERCEL_PROJECT_ID is not provided automatically by the runtime.
VERCEL_PROJECT_ID=
# Optional: required when the project belongs to a Vercel team.
VERCEL_TEAM_ID=
