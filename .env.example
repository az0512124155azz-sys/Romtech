# Server-only. Never prefix these with NEXT_PUBLIC_, VITE_, or expose in HTML.
ROMTECH_ORIGIN=https://romtech-alpha.vercel.app
ROMTECH_STORE_PREFIX=romtech-production
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 32 random bytes, base64 encoded. Keep stable across deployments.
ROMTECH_ENCRYPTION_KEY=
# Generated by npm run owner-password (reads the password without echo).
ROMTECH_OWNER_PASSWORD_HASH=
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
